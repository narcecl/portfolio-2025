---
import '@/styles/global.css';
import Analytics from '@vercel/analytics/astro';
import Footer from '@/components/Footer.astro';
import locale from '@/i18n/lang.json';
import type { Locale } from '@/interfaces/lang';

const currentLang: Locale = (Astro.currentLocale as Locale) || 'es';
const language = locale[currentLang];

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Nicolás Arce',
    url: 'https://narce.cl',
    jobTitle: currentLang === 'es' ? 'Desarrollador Front-end' : 'Front-end Developer',
    knowsAbout: ['Front-end Development', 'Accessibility', 'Design Systems', 'User Experience', 'Web Performance'],
    sameAs: ['https://github.com/narcecl', 'https://www.linkedin.com/in/narcecl/'],
    email: 'hola@narce.cl',
    image: 'https://narce.cl/og-image.jpg',
    description: language.meta.description,
};

const websiteJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Nicolás Arce',
    url: 'https://narce.cl',
    description: language.meta.description,
    inLanguage: currentLang === 'es' ? 'es-CL' : 'en',
};
---

<!doctype html>
<html lang={currentLang === 'es' ? 'es-CL' : 'en'}>
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1"
        />
        <link
            rel="icon"
            type="image/png"
            href="/favicon.png"
        />
        <link
            rel="apple-touch-icon"
            href="/favicon.png"
        />
        <link
            rel="manifest"
            href="/manifest.json"
        />
        <meta
            name="generator"
            content={Astro.generator}
        />
        <title>{language.meta.title}</title>
        <meta
            name="theme-color"
            content="#1a1a1a"
            media="(prefers-color-scheme: dark)"
        />
        <meta
            name="description"
            content={language.meta.description}
        />
        <link
            rel="canonical"
            href={canonicalURL}
        />

        <link
            rel="author"
            href="narce.cl"
        />
        <meta
            name="author"
            content="Nicolás Arce"
        />

        <link
            rel="preconnect"
            href="https://fonts.googleapis.com"
        />
        <link
            rel="preconnect"
            href="https://fonts.gstatic.com"
            crossorigin
        />
        <link
            rel="preload"
            href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Gabarito:wght@400..900&display=swap"
            as="style"
            fetchpriority="low"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Gabarito:wght@400..900&display=swap"
            rel="stylesheet"
        />

        <meta
            property="og:title"
            content={language.meta.title}
        />
        <meta
            property="og:description"
            content={language.meta.description}
        />
        <meta
            property="og:type"
            content="website"
        />
        <meta
            property="og:url"
            content={Astro.url.href}
        />
        <meta
            property="og:image"
            content="https://narce.cl/og-image.jpg"
        />
        <meta
            property="og:image:width"
            content="1200"
        />
        <meta
            property="og:image:height"
            content="630"
        />
        <!-- Crear imagen -->
        <meta
            property="og:locale"
            content={currentLang === 'es' ? 'es_CL' : 'en_US'}
        />

        <meta
            name="twitter:card"
            content="summary_large_image"
        />
        <meta
            name="twitter:title"
            content={language.meta.title}
        />
        <meta
            name="twitter:description"
            content={language.meta.description}
        />
        <meta
            name="twitter:image"
            content="https://narce.cl/og-image.jpg"
        />

        <!-- Enlaces hreflang para SEO internacional -->
        <link
            rel="alternate"
            hreflang="es-CL"
            href="/"
        />
        <link
            rel="alternate"
            hreflang="en"
            href="/en/"
        />
        <link
            rel="alternate"
            hreflang="x-default"
            href="/"
        />

        <!-- Google Tag Manager -->
        <script is:inline>
            (function (w, d, s, l, i) {
                w[l] = w[l] || [];
                w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
                var f = d.getElementsByTagName(s)[0],
                    j = d.createElement(s),
                    dl = l != 'dataLayer' ? '&l=' + l : '';
                j.async = true;
                j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
                f.parentNode.insertBefore(j, f);
            })(window, document, 'script', 'dataLayer', 'GTM-PBW52NLQ');
        </script>
        <!-- End Google Tag Manager -->
        <script
            type="application/ld+json"
            set:html={JSON.stringify(jsonLd)}
        />
        <script
            type="application/ld+json"
            set:html={JSON.stringify(websiteJsonLd)}
        />
    </head>

    <body class="font-sans bg-black">
        <!-- Google Tag Manager (noscript) -->
        <noscript>
            <iframe
                src="https://www.googletagmanager.com/ns.html?id=GTM-PBW52NLQ"
                height="0"
                width="0"
                style="display:none;visibility:hidden"
                title="Google Tag Manager"
            ></iframe>
        </noscript>
        <!-- End Google Tag Manager (noscript) -->

        <Analytics />

        <main class="max-w-3xl px-4 sm:px-5 mx-auto">
            <slot />
        </main>

        <Footer />
    </body>
</html>
