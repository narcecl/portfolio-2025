---
import Section from './Section.astro';
import { getCollection, render } from 'astro:content';
import locale from '@/i18n/lang.json';
import type { Locale } from '@/interfaces/lang';

const currentLang: Locale = (Astro.currentLocale as Locale) || 'es';
const language = locale[currentLang];

const work = await getCollection('work');
const filteredWorks = work.filter(({ data: { lang = 'es' } }) => lang === currentLang);
const sortedWork = filteredWorks.sort((a, b) => a.data.order - b.data.order);
---

<Section {...Astro.props}>
    <div class="flex flex-col gap-14">
        <div class="flex flex-col gap-2 animate-fade-down animate-delay-300">
            <h2 class="font-serif text-4xl text-white font-bold tracking-tightest">
                {language.sections.work.title}
            </h2>

            <p class="text-gray-300 text-lg font-light">
                {language.sections.work.description}
            </p>
            <p class="text-gray-300 text-lg font-light">
                {
                    currentLang === 'en' ? (
                        <>
                            You can explore all my work experience on my{' '}
                            <a
                                href="https://www.linkedin.com/in/narcecl/"
                                class="text-sky-400 hover:text-sky-400 underline"
                                target="_blank"
                                rel="noreferrer noopener"
                            >
                                LinkedIn
                            </a>{' '}
                            profile.
                        </>
                    ) : (
                        <>
                            Puedes conocer toda mi experiencia laboral en mi perfil de{' '}
                            <a
                                href="https://www.linkedin.com/in/narcecl/"
                                class="text-sky-400 hover:text-sky-400 underline"
                                target="_blank"
                                rel="noreferrer noopener"
                            >
                                LinkedIn
                            </a>
                            .
                        </>
                    )
                }
            </p>
        </div>

        <div class="flex flex-col gap-4">
            {
                sortedWork.map(async item => {
                    const { data } = item;
                    const { company, position, image, startDate, endDate, stack } = data;
                    const { Content } = await render(item);

                    return (
                        <div class="group flex flex-col gap-8 border border-card p-4 sm:p-6 rounded-2xl hover:border-primary transition-colors duration-300">
                            <div class="flex flex-col sm:flex-row sm:items-center gap-4">
                                {image && (
                                    <picture class="size-10 rounded-full overflow-hidden shrink-0">
                                        <img
                                            src={image}
                                            alt={currentLang === 'en' ? `${company} logo` : `Logo de ${company}`}
                                            class="h-full w-full object-cover"
                                            loading="lazy"
                                            decoding="async"
                                            width="40"
                                            height="40"
                                        />
                                    </picture>
                                )}
                                <div>
                                    <div class="flex flex-col">
                                        <h3 class="text-sky-500 text-xl font-serif">{position}</h3>
                                        <p class="text-gray-300 font-light text-sm flex flex-col sm:flex-row flex-wrap sm:gap-2">
                                            <span>{company}</span>
                                            <span class="hidden sm:inline">•</span>
                                            <span>
                                                {startDate} - {endDate}
                                            </span>
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div class="text-white font-light">
                                <Content />
                            </div>
                            <ul class="flex flex-wrap gap-1">
                                {stack.map((stackItem, index) => (
                                    <>
                                        <li class="text-gray-300 text-sm font-light">
                                            {stackItem}
                                            {index < stack.length - 1 ? <span class="ml-1">•</span> : null}
                                        </li>
                                    </>
                                ))}
                            </ul>
                        </div>
                    );
                })
            }
        </div>
    </div>
</Section>
