---
import Section from './Section.astro';
import { getCollection, render } from 'astro:content';
import locale from '@/i18n/lang.json';
import type { Locale } from '@/interfaces/lang';

const currentLang: Locale = (Astro.currentLocale as Locale) || 'es';
const language = locale[currentLang];

const projects = await getCollection('projects');
const filteredProjects = projects.filter(({ data: { lang = 'es' } }) => lang === currentLang);
const sortedProjects = filteredProjects.sort((a, b) => a.data.order - b.data.order);
---

<Section {...Astro.props}>
    <div class="flex flex-col gap-14">
        <div class="flex flex-col gap-2">
            <h2 class="font-serif text-4xl text-white font-bold tracking-tightest">
                {language.sections.projects.title}
            </h2>

            <div>
                <p class="text-gray-300 text-lg font-light">
                    {language.sections.projects.description}
                </p>
                <p class="text-gray-300 text-lg font-light">
                    {
                        currentLang === 'en' ? (
                            <>
                                If you prefer, you can see all my projects and contributions on my{' '}
                                <a
                                    href="https://github.com/narcecl"
                                    class="text-sky-400 hover:text-sky-400 underline"
                                    target="_blank"
                                    rel="noreferrer noopener"
                                >
                                    GitHub
                                </a>{' '}
                                profile.
                            </>
                        ) : (
                            <>
                                Si prefieres, puedes ver todos mis proyectos y contribuciones en mi perfil de{' '}
                                <a
                                    href="https://github.com/narcecl"
                                    class="text-sky-400 hover:text-sky-400 underline"
                                    target="_blank"
                                    rel="noreferrer noopener"
                                >
                                    GitHub
                                </a>
                                .
                            </>
                        )
                    }
                </p>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {
                sortedProjects.map(async item => {
                    const { data } = item;
                    const { name, stack, cover, url, github } = data;
                    const { Content } = await render(item);

                    return (
                        <div class="group flex flex-col border border-card hover:border-primary rounded-2xl overflow-hidden transition-colors duration-300">
                            <div>
                                <picture class="h-full w-full">
                                    <img
                                        src={cover}
                                        alt={
                                            currentLang === 'en'
                                                ? `Screenshot of ${name} project`
                                                : `Captura del proyecto ${name}`
                                        }
                                        class="h-full w-full max-h-[300px] object-cover"
                                        loading="lazy"
                                        decoding="async"
                                        width="600"
                                        height="300"
                                    />
                                </picture>
                            </div>
                            <div class="flex flex-col gap-6 p-4 md:py-6 md:px-4">
                                <div class="flex flex-col gap-4">
                                    <div>
                                        <h3 class="text-sky-500 text-xl font-serif">{name}</h3>
                                        <p class="text-gray-300 text-sm font-light">{stack.join(' • ')}</p>
                                    </div>
                                    <div class="text-white text-base font-light">
                                        <Content />
                                    </div>
                                </div>

                                <div class="flex max-[374px]:flex-col sm:flex-row gap-2 items-start sm:items-center *:flex-1">
                                    {url && (
                                        <a
                                            id="projects__url__button"
                                            class="text-center text-sm py-2 px-4 text-white bg-sky-700 hover:bg-sky-800 rounded-full transition-all"
                                            href={url}
                                            target="_blank"
                                            rel="noreferrer noopener"
                                        >
                                            {currentLang === 'en' ? 'See in action' : 'Ir al proyecto'}
                                        </a>
                                    )}
                                    {github && (
                                        <a
                                            id="projects__github__button"
                                            class="text-center text-sm py-2 px-4 text-white hover:bg-card rounded-full transition-all border border-card"
                                            href={github}
                                            target="_blank"
                                            rel="noreferrer noopener"
                                        >
                                            {currentLang === 'en' ? 'Browse Github' : 'Ver en GitHub'}
                                        </a>
                                    )}
                                </div>
                            </div>
                        </div>
                    );
                })
            }
        </div>
    </div></Section
>
